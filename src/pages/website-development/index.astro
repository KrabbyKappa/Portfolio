---
const destination = 'https://websites.lucakosowski.com/';
const title = 'Website Development moved to Websites by Luca Kosowski';
const description = 'The website-development service by Luca Kosowski has moved to websites.lucakosowski.com.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex,follow">
  <link rel="canonical" href={destination}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={destination}>
  <meta http-equiv="refresh" content={`0; url=${destination}`}>
  <script is:inline define:vars={{ destination }}>
    window.location.replace(destination);
  </script>
  <script data-goatcounter="https://lucakosowski.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
</head>
<body>
  <main style="font-family: system-ui, sans-serif; max-width: 42rem; margin: 12vh auto; padding: 1.5rem; line-height: 1.6;">
    <h1>Website Development moved</h1>
    <p>The website-development service by Luca Kosowski now lives at <a href={destination}>websites.lucakosowski.com</a>.</p>
  </main>
</body>
</html>

---
import ShowcaseLayout from '../../layouts/ShowcaseLayout.astro';
import { Image } from 'astro:assets';
import { serviceFaq } from '../../data/seo/serviceFaq';

const realCaseStudies = [
  {
    name: 'Bizwholistic',
    href: 'https://bizwholistic.com/',
    image: 'assets/site-previews/bizwholistic.jpg',
    imageWidth: 1440,
    imageHeight: 980,
    summary: 'Built in Astro for speed and reliability, this professional website adapts Bizwholistic’s logos and branding into clear, trustworthy pages with custom graphics tailored to how the business works.',
  },
];

const selectedDemos = [
  {
    name: 'Mosaic Content Studio',
    slug: 'mosaic-content-studio',
    image: 'assets/site-previews/mosaic-content-studio.jpg',
    imageWidth: 1440,
    imageHeight: 980,
    href: 'demos/basic/mosaic-content-studio/',
    cardClass: 'demo-card--creative',
    livePreview: true,
    summary: 'Cut-paper collage direction for a small content and creative service studio.',
    proof: 'Strongest for showing expressive art direction, distinctive copy, and a memorable one-page brand world.',
  },
  {
    name: 'Verde Lunch Club',
    slug: 'verde-lunch-club',
    image: 'assets/site-previews/verde-lunch-club.jpg',
    imageWidth: 1440,
    imageHeight: 980,
    href: 'demos/basic/verde-lunch-club/',
    cardClass: 'demo-card--green',
    summary: 'Garden, menu, map, and visit context for a small lunch and catering brand.',
    proof: 'Shows how a Basic page can feel placed in the real world with photos, practical hours, and location context.',
  },
  {
    name: 'Mila Yoga Reset',
    slug: 'mila-yoga-testimonial',
    image: 'assets/site-previews/mila-yoga-testimonial.jpg',
    imageWidth: 1440,
    imageHeight: 980,
    href: 'demos/micro/mila-yoga-testimonial/',
    cardClass: 'demo-card--soft',
    summary: 'Soft studio page for a solo wellness service and testimonial-led presence.',
    proof: 'Shows gentler trust-building: service fit, note-like testimonials, and direct contact without fake automation.',
  },
  {
    name: 'Harbor Legal Translation',
    slug: 'harbor-legal-translation',
    image: 'assets/site-previews/harbor-legal-translation.jpg',
    imageWidth: 3024,
    imageHeight: 1718,
    href: 'demos/basic/harbor-legal-translation/',
    cardClass: 'demo-card--legal',
    summary: 'Certified legal-translation intake page with dossier styling, service boundaries, and direct handoff.',
    proof: 'Useful for professional services that need trust, scope clarity, and sensitive-document caution without a custom portal.',
  },
  {
    name: 'City Lab Pop-Up',
    slug: 'city-lab-pop-up',
    image: 'assets/site-previews/city-lab-pop-up.jpg',
    imageWidth: 1440,
    imageHeight: 980,
    href: 'demos/micro/city-lab-pop-up/',
    cardClass: 'demo-card--bright',
    summary: 'Fluorescent event-poster direction for a one-page workshop announcement.',
    proof: 'Best for proving a Micro page can be loud, focused, and useful without forms, booking, or backend scope.',
  },
];

const websiteAsset = (path) => `/website-development/${path}`;

// Process illustration controls.
// Edit these values when tuning the three SVGs in the browser:
// - x: move the whole illustration container right (+) or left (-)
// - y: move the whole illustration container down (+) or up (-)
// - scale: zoom the SVG/image inside its reserved box
// - width: reserved illustration width inside the card
// - box: reserved illustration height, kept equal across cards so the text stays aligned
const processIllustrationControls = {
  ideas: { x: '3.75rem', y: '-3.55rem', scale: 1.16, width: '13rem', box: '13rem' },
  together: { x: '3.7rem', y: '-1.0rem', scale: 1.0, width: '13rem', box: '13rem' },
  delivered: { x: '4.0rem', y: '0.7rem', scale: 1.0, width: '13rem', box: '13rem' },
};

// Sparkle controls use SVG coordinate units inside the final-result overlay viewBox.
// x moves right, y moves down, scale changes the individual sparkle size.
const processSparkleControls = {
  one: { x: 165, y: -10, scale: 0.78 },
  two: { x: 154, y: 15, scale: 0.52 },
  three: { x: 137, y: 0, scale: 0.40 },
};

const processArtStyle = ({ x = '0rem', y = '0rem', scale = 1, width = '13rem', box = '13rem' }) =>
  `--process-art-x: ${x}; --process-art-y: ${y}; --process-art-scale: ${scale}; --process-art-width: ${width}; --process-art-box: ${box};`;

const sparkleTransform = ({ x = 0, y = 0, scale = 1 }) => `translate(${x} ${y}) scale(${scale})`;
---
<ShowcaseLayout title="Your Ideal Website – Luca Kosowski" description="A premium showcase of live case-study context and selected showcase sites for Luca Kosowski's Website Development portfolio." canonicalPath="/website-development/" ogTitle="Your Ideal Website – Luca Kosowski" ogDescription="Explore a live business case study, polished visual previews, and complete showcase routes for different website directions." faqItems={serviceFaq}>
<a class="skip-link" href="#strategy">Skip to website process</a>


  <header class="showcase-topbar" aria-label="Showcase navigation">
    <a href="../projects.html#video1" class="identity">Luca Kosowski</a>
    <nav>
      <a href="#strategy">Process</a>
      <a href="#demos">Showcases</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>


  <main>
    <section id="proof" class="hero hero--proof" aria-labelledby="showcase-title">
      <div class="hero-layout">
        <div class="hero-copy">
          <h1 id="showcase-title">Your ideal website, shaped around your ambition.</h1>
        </div>

        <div class="hero-case" id="case-study" aria-label="Live Bizwholistic case study">
          {realCaseStudies.map((study) => (
            <article class="demo-card demo-card--featured demo-card--case-study" data-case-study="bizwholistic">
              <a class="case-study-link" href={study.href} aria-label={`Open the live ${study.name} website`}>
                <figure class="site-shot">
                  <Image src={websiteAsset(study.image)} width={study.imageWidth} height={study.imageHeight} alt={`${study.name} website screenshot`} loading="eager" decoding="async" />
                </figure>
                <h3>{study.name}</h3>
                <p>{study.summary}</p>
                <span class="open-live">Open live site</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="strategy" class="scope-note decision-note" aria-labelledby="strategy-heading">
      <p class="eyebrow">A simple way to get online</p>
      <h2 id="strategy-heading">The website you need, can be delivered promptly.</h2>
      <p>You do not need to arrive with everything figured out. I learn what your business does, suggest a few clear directions, help shape the structure, content, and message, then build a professional website that feels right, loads quickly, and makes it easy for people to contact you. I also make clear which costs are separate, such as domain and hosting, and can help you set them up.</p>
      <div class="decision-grid" aria-label="Website process priorities">
        <article>
          <strong>Clear from the start</strong>
          <span>I explain what I need from you, what I will handle, which costs are separate, and what the next steps look like.</span>
        </article>
        <article>
          <strong>Built around your business</strong>
          <span>I adapt the design, branding, wording, pages, and flow so the website represents what you do in a clear and polished way.</span>
        </article>
        <article>
          <strong>Fast, practical, and easy to improve</strong>
          <span>You get a light, responsive website with smooth communication, thoughtful details, and a well-documented setup that can be edited or improved over time.</span>
        </article>
      </div>

      <div class="process-flow">
        <h3>From first ideas to finished site</h3>
        <div class="decision-grid decision-grid--steps" aria-label="Website build steps">
          <article>
            <div class="process-illustration process-illustration--ideas" data-process-art="ideas" style={processArtStyle(processIllustrationControls.ideas)} aria-hidden="true">
              <div class="process-illustration__stage">
                <Image src="/website-development/assets/process/three-starting-ideas.svg" width={150} height={150} alt="" loading="lazy" decoding="async" />
              </div>
            </div>
            <strong>Three starting ideas</strong>
            <span>I send three initial website ideas so you can quickly see which direction feels right.</span>
          </article>
          <article>
            <div class="process-illustration process-illustration--together" data-process-art="together" style={processArtStyle(processIllustrationControls.together)} aria-hidden="true">
              <div class="process-illustration__stage">
                <Image src="/website-development/assets/process/shape-it-together-two-hands.svg" width={150} height={150} alt="" loading="lazy" decoding="async" />
              </div>
            </div>
            <strong>Shape it together</strong>
            <span>We decide the style, pages, and features together, then estimate the cost based on the complexity needed.</span>
          </article>
          <article>
            <div class="process-illustration process-illustration--delivered" data-process-art="delivered" style={processArtStyle(processIllustrationControls.delivered)} aria-hidden="true">
              <div class="process-illustration__stage">
                <Image src="/website-development/assets/process/final-result.svg" width={150} height={150} alt="" loading="lazy" decoding="async" />
                <svg class="process-sparkle-layer" viewBox="0 0 180 124" focusable="false">
                  <g data-sparkle="one" transform={sparkleTransform(processSparkleControls.one)}>
                    <path class="process-sparkle process-sparkle--one" d="M0 -16 C2.8 -5.8 5.8 -2.8 16 0 C5.8 2.8 2.8 5.8 0 16 C-2.8 5.8 -5.8 2.8 -16 0 C-5.8 -2.8 -2.8 -5.8 0 -16Z"></path>
                  </g>
                  <g data-sparkle="two" transform={sparkleTransform(processSparkleControls.two)}>
                    <path class="process-sparkle process-sparkle--two" d="M0 -16 C2.8 -5.8 5.8 -2.8 16 0 C5.8 2.8 2.8 5.8 0 16 C-2.8 5.8 -5.8 2.8 -16 0 C-5.8 -2.8 -2.8 -5.8 0 -16Z"></path>
                  </g>
                  <g data-sparkle="three" transform={sparkleTransform(processSparkleControls.three)}>
                    <path class="process-sparkle process-sparkle--three" d="M0 -16 C2.8 -5.8 5.8 -2.8 16 0 C5.8 2.8 2.8 5.8 0 16 C-2.8 5.8 -5.8 2.8 -16 0 C-5.8 -2.8 -2.8 -5.8 0 -16Z"></path>
                  </g>
                </svg>
              </div>
            </div>
            <strong>Built and delivered</strong>
            <span>I build and deliver the website. Simple template-like one-page websites are usually ready in 3 days after you provide the content and direction, subject to scope.</span>
          </article>
        </div>
      </div>
    </section>

    <section id="demos" class="demo-index" aria-labelledby="demos-heading">
      <div class="section-heading">
        <h2 id="demos-heading">Website showcases and templates</h2>
        <p>Think of these showcases as helpful examples rather than fixed packages: they give you a simple way to see different directions your website could take. If you like the feel of one, I can use it as a template and shape it around your real business, branding, wording, images, services, and goals.</p>
      </div>

      <div class="demo-grid demo-grid--selected">
        {selectedDemos.map((demo, index) => (
          <article class={`demo-card demo-card--featured ${demo.cardClass}`} data-demo-slug={demo.slug} data-live-preview-card={demo.livePreview ? demo.slug : undefined}>
            <a
              class="demo-card__full-link"
              href={demo.href}
              data-demo-card-link={demo.slug}
              aria-label={`Open the full ${demo.name} Astro showcase`}
            ></a>
            <figure class={`site-shot ${demo.livePreview ? 'site-shot--live-demo' : ''}`} data-live-preview={demo.livePreview ? demo.slug : undefined}>
              {demo.livePreview ? (
                <div class="live-preview-shell">
                  <iframe
                    class="live-demo-frame"
                    data-live-demo-preview={demo.slug}
                    src={demo.href}
                    title={`Live animated preview of the ${demo.name} Astro showcase`}
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    sandbox="allow-same-origin"
                    scrolling="no"
                    tabindex="-1"
                  ></iframe>
                  <Image class="live-preview-fallback" src={websiteAsset(demo.image)} width={demo.imageWidth} height={demo.imageHeight} alt="" loading="lazy" decoding="async" aria-hidden="true" />
                </div>
              ) : (
                <Image src={websiteAsset(demo.image)} width={demo.imageWidth} height={demo.imageHeight} alt={`Screenshot preview of the ${demo.name} website`} loading="lazy" decoding="async" />
              )}
            </figure>
            <h3>{demo.name}</h3>
            <p>{demo.summary}</p>
            <p class="proof-line">{demo.proof}</p>
            <div class="demo-actions" aria-hidden="true">
              <span class="demo-action-label">Open full Astro showcase</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="service-faq" class="scope-note decision-note service-faq" aria-labelledby="service-faq-heading">
      <p class="eyebrow">Common questions</p>
      <h2 id="service-faq-heading">Questions before starting a website</h2>
      <div class="service-faq-list service-faq-list--dropdown" aria-label="Website-development frequently asked questions">
        {serviceFaq.map((item) => (
          <details class="service-faq-item" data-service-faq-item={item.question}>
            <summary data-faq-summary>
              <span>{item.question}</span>
              <span class="service-faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="service-faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section id="contact" class="scope-note decision-note" aria-labelledby="contact-heading">
      <p class="eyebrow">Direct inquiry</p>
      <h2 id="contact-heading">Contact information</h2>
      <p>For collaborations or inquiries, please use the contact information below or send me a message.</p>
      <div class="decision-grid" aria-label="Contact methods">
        <article>
          <strong>Email</strong>
          <span><a href="mailto:hello@lucakosowski.com">hello@lucakosowski.com</a></span>
        </article>
        
        <article>
          <strong>LinkedIn</strong>
          <span><a href="https://www.linkedin.com/in/luca-kosowski/" target="_blank" rel="noopener noreferrer">linkedin.com/in/luca-kosowski</a></span>
        </article>
      </div>
    </section>


  </main>

</ShowcaseLayout>

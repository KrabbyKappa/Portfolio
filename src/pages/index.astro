  <!-- Scripts -->
  <script is:inline>
    // Mobile Quality of Life: Close details when clicking outside links
    document.querySelectorAll('details').forEach((detail) => {
      detail.addEventListener('click', (e) => {
        if (detail.hasAttribute('open')) {
          // If clicking the summary, default behavior toggles it (closes).
          // If clicking content (not summary), we manually close it unless it's a link.
          if (!e.target.closest('summary') && e.target.tagName !== 'A') {
            detail.removeAttribute('open');
          }
        }
      });
    });

    // Mobile Menu Toggle
    const menuToggle = document.querySelector('.menu-toggle');
    const siteHeader = document.querySelector('.site-header');
    const navLinks = document.querySelectorAll('.main-nav a');

    if (menuToggle) {
        menuToggle.addEventListener('click', () => {
            siteHeader.classList.toggle('nav-open');
        });

        // Close menu when a link is clicked
        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                siteHeader.classList.remove('nav-open');
            });
        });
    }

    // Muted local video preview loops: start only when visible to keep weak phones smooth.
    (() => {
      const loopCards = Array.from(document.querySelectorAll('[data-video-loop-card]'));
      if (!loopCards.length) return;

      const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
      const startVideo = (card, video) => {
        if (prefersReducedMotion) return;
        card.dataset.loopInView = 'true';
        video.muted = true;
        video.playsInline = true;
        const attempt = video.play();
        if (attempt?.catch) {
          attempt.catch(() => card.classList.add('is-fallback'));
        }
      };
      const pauseVideo = (card, video) => {
        card.dataset.loopInView = 'false';
        video.pause();
        card.classList.remove('is-fading');
      };

      loopCards.forEach((card) => {
        const video = card.querySelector('video.preview-video-frame');
        const fadeMs = Number(card.dataset.fadeMs || 650);
        if (!video) return;

        let fading = false;
        const fadeWindow = Math.max(0.35, fadeMs / 1000);
        const markReady = () => {
          card.dataset.loopReady = 'true';
          card.classList.add('is-ready');
        };

        video.addEventListener('loadedmetadata', markReady, { once: true });
        video.addEventListener('canplay', markReady, { once: true });
        video.addEventListener('timeupdate', () => {
          if (!video.duration || Number.isNaN(video.duration)) return;
          if (!fading && video.duration - video.currentTime <= fadeWindow) {
            fading = true;
            card.classList.add('is-fading');
          }
        });
        video.addEventListener('ended', () => {
          video.currentTime = 0;
          if (card.dataset.loopInView === 'true') startVideo(card, video);
          window.setTimeout(() => {
            card.classList.remove('is-fading');
            fading = false;
          }, 90);
        });

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) startVideo(card, video);
              else pauseVideo(card, video);
            });
          }, { rootMargin: '160px 0px', threshold: 0.2 });
          observer.observe(card);
        } else {
          startVideo(card, video);
        }
      });
    })();
  </script>

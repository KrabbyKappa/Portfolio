  <!-- Scripts -->
  <script is:inline>
    // Mobile Quality of Life: Close details when clicking outside links
    document.querySelectorAll('details').forEach((detail) => {
      detail.addEventListener('click', (e) => {
        if (detail.hasAttribute('open')) {
          // If clicking the summary, default behavior toggles it (closes).
          // If clicking content (not summary), we manually close it unless it's a link.
          if (!e.target.closest('summary') && e.target.tagName !== 'A') {
            detail.removeAttribute('open');
          }
        }
      });
    });

    // Muted local video preview loops: start only when visible to keep weak phones smooth.
    (() => {
      const loopCards = Array.from(document.querySelectorAll('[data-video-loop-card]'));
      if (!loopCards.length) return;

      const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
      const startVideo = (card, video) => {
        if (prefersReducedMotion) return;
        card.dataset.loopInView = 'true';
        video.muted = true;
        video.playsInline = true;
        const attempt = video.play();
        if (attempt?.catch) {
          attempt.catch(() => card.classList.add('is-fallback'));
        }
      };
      const pauseVideo = (card, video) => {
        card.dataset.loopInView = 'false';
        video.pause();
        card.classList.remove('is-fading');
      };

      loopCards.forEach((card) => {
        const video = card.querySelector('video.preview-video-frame');
        const fadeMs = Number(card.dataset.fadeMs || 650);
        if (!video) return;

        let fading = false;
        const fadeWindow = Math.max(0.35, fadeMs / 1000);
        const markReady = () => {
          card.dataset.loopReady = 'true';
          card.classList.add('is-ready');
        };

        video.addEventListener('loadedmetadata', markReady, { once: true });
        video.addEventListener('canplay', markReady, { once: true });
        video.addEventListener('timeupdate', () => {
          if (!video.duration || Number.isNaN(video.duration)) return;
          if (!fading && video.duration - video.currentTime <= fadeWindow) {
            fading = true;
            card.classList.add('is-fading');
          }
        });
        video.addEventListener('ended', () => {
          video.currentTime = 0;
          if (card.dataset.loopInView === 'true') startVideo(card, video);
          window.setTimeout(() => {
            card.classList.remove('is-fading');
            fading = false;
          }, 90);
        });

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) startVideo(card, video);
              else pauseVideo(card, video);
            });
          }, { rootMargin: '160px 0px', threshold: 0.2 });
          observer.observe(card);
        } else {
          startVideo(card, video);
        }
      });
    })();

    // On touch-sized screens, reveal each project action only after its own
    // card has remained in view long enough to be deliberately read.
    (() => {
      const mobileViewport = window.matchMedia?.('(max-width: 760px)');
      const projectCards = Array.from(document.querySelectorAll('#projects .preview-card'));
      if (!mobileViewport?.matches || !projectCards.length) return;

      const revealTimers = new WeakMap();
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const card = entry.target;
          const existingTimer = revealTimers.get(card);

          if (entry.isIntersecting) {
            if (existingTimer) return;
            const timer = window.setTimeout(() => {
              card.classList.add('is-project-action-visible');
              revealTimers.delete(card);
            }, 1500);
            revealTimers.set(card, timer);
            return;
          }

          if (existingTimer) window.clearTimeout(existingTimer);
          revealTimers.delete(card);
          card.classList.remove('is-project-action-visible');
        });
      }, {
        rootMargin: '-35% 0px -35%',
        threshold: 0.15,
      });

      projectCards.forEach((card) => observer.observe(card));
    })();

    // Preserve the scroll-wheel pose at activation, then settle from that
    // exact frame so opening or closing a role never begins with a size jump.
    (() => {
      const roles = Array.from(document.querySelectorAll('#experience details.experience-item'));
      roles.forEach((role) => {
        const summary = role.querySelector('summary');
        if (!summary) return;

        let cleanupTimer;
        let releaseViewportLock = () => {};
        let maintainViewportScroll = () => {};
        const lockViewportScroll = () => {
          releaseViewportLock();
          const lockedScrollY = window.scrollY;
          let active = true;
          let animationFrame;
          let lockTimer;

          releaseViewportLock = () => {
            if (!active) return;
            active = false;
            window.cancelAnimationFrame(animationFrame);
            window.clearTimeout(lockTimer);
            window.removeEventListener('wheel', releaseViewportLock);
            window.removeEventListener('touchmove', releaseViewportLock);
            window.removeEventListener('keydown', releaseViewportLock);
            maintainViewportScroll = () => {};
          };

          maintainViewportScroll = () => {
            if (!active) return;
            if (Math.abs(window.scrollY - lockedScrollY) > 0.5) {
              window.scrollTo(0, lockedScrollY);
            }
          };

          const keepViewportStill = () => {
            maintainViewportScroll();
            animationFrame = window.requestAnimationFrame(keepViewportStill);
          };

          window.addEventListener('wheel', releaseViewportLock, { passive: true });
          window.addEventListener('touchmove', releaseViewportLock, { passive: true });
          window.addEventListener('keydown', releaseViewportLock);
          lockTimer = window.setTimeout(releaseViewportLock, 1100);
          animationFrame = window.requestAnimationFrame(keepViewportStill);
        };

        const syncPillRadius = () => {
          const pillRadius = (summary.offsetHeight + 12) / 2;
          role.style.setProperty('--role-pill-radius', `${pillRadius}px`);
        };
        syncPillRadius();
        const pillRadiusObserver = new ResizeObserver(() => {
          if (!role.open) syncPillRadius();
        });
        pillRadiusObserver.observe(summary);

        const clearTransitionState = () => {
          window.clearTimeout(cleanupTimer);
          role.classList.remove('is-role-transitioning', 'is-role-settling', 'is-role-open-frozen');
          role.style.removeProperty('--role-from-transform');
          role.style.removeProperty('--role-from-scale');
          role.style.removeProperty('--role-to-transform');
          role.style.removeProperty('--role-to-scale');
        };

        summary.addEventListener('click', () => {
          lockViewportScroll();
          window.clearTimeout(cleanupTimer);
          role.classList.remove('is-role-settling');
          if (!role.open) syncPillRadius();
          const current = getComputedStyle(role);
          role.style.setProperty('--role-from-transform', current.transform === 'none' ? 'none' : current.transform);
          role.style.setProperty('--role-from-scale', current.scale === 'none' ? '1' : current.scale);
          role.classList.add('is-role-transitioning');
          maintainViewportScroll();
        });

        role.addEventListener('toggle', () => {
          if (!role.classList.contains('is-role-transitioning')) return;

          if (role.open) {
            role.classList.add('is-role-open-frozen');
            maintainViewportScroll();
            return;
          }

          role.classList.remove('is-role-transitioning', 'is-role-open-frozen');
          const target = getComputedStyle(role);
          const targetTransform = target.transform === 'none' ? 'none' : target.transform;
          const targetScale = target.scale === 'none' ? '1' : target.scale;
          role.classList.add('is-role-transitioning');
          role.style.setProperty('--role-to-transform', targetTransform);
          role.style.setProperty('--role-to-scale', targetScale);
          maintainViewportScroll();

          void role.offsetWidth;
          requestAnimationFrame(() => {
            role.classList.add('is-role-settling');
            maintainViewportScroll();
          });
          cleanupTimer = window.setTimeout(clearTransitionState, 900);
        });
      });
    })();
  </script>
</BaseLayout>

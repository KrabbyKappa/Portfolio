---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact Luca Kosowski"
  description="Contact Luca Kosowski directly for professional inquiries, references, collaborations, and website-development routing."
  canonicalPath="/contact.html"
  ogTitle="Contact Luca Kosowski"
  ogDescription="Contact details for Luca Kosowski, with separate routing for professional inquiries and Websites by Luca website projects."
>
<header class="site-header">
    <div class="header-content">
      <a href="index.html" class="logo">Luca Kosowski</a>
      <button class="menu-toggle" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="main-nav">
        <a href="index.html" class="nav-mobile-only">Home</a>
        <a href="https://websites.lucakosowski.com/">Websites</a>
        <a href="articles.html" class="nav-desktop-only">Articles</a>
        <a href="projects.html">Projects</a>
        <a href="references.html">References</a>
        <a href="contact.html">Contact</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="main-wrapper contact-page-wrapper">
      <section class="page-hero contact-page-hero" aria-labelledby="contact-title">
        <h1 id="contact-title">Get in touch</h1>
        <p class="lead">For professional inquiries, collaborations, or website work, start with a direct message.</p>
        <div class="hero-actions">
          <a href="mailto:hello@lucakosowski.com" class="cta-primary">
            <span class="contact-action-layer" aria-hidden="true"></span>
            <span class="contact-action-face">
              <span class="contact-action-copy">Email Luca</span>
            </span>
          </a>
          <a href="https://www.linkedin.com/in/luca-kosowski/" target="_blank" rel="noopener noreferrer" class="cta-secondary">
            <span class="contact-action-layer" aria-hidden="true"></span>
            <span class="contact-action-face">
              <span class="contact-action-copy">LinkedIn</span>
            </span>
          </a>
        </div>
      </section>

    </div>
  </main>

  <footer class="site-footer">
    <nav class="footer-links" aria-label="Contact and website links">
      <a href="mailto:hello@lucakosowski.com">Email</a>
      <a href="https://www.linkedin.com/in/luca-kosowski/">LinkedIn</a>
      <a href="https://websites.lucakosowski.com/">Website Development</a>
    </nav>
  </footer>

  <script is:inline>
    const menuToggle = document.querySelector('.menu-toggle');
    const siteHeader = document.querySelector('.site-header');
    const navLinks = document.querySelectorAll('.main-nav a');

    if (menuToggle) {
        menuToggle.addEventListener('click', () => {
            siteHeader.classList.toggle('nav-open');
        });

        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                siteHeader.classList.remove('nav-open');
            });
        });
    }
  </script>
</BaseLayout>

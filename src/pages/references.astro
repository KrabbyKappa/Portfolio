---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="References – Luca Kosowski" description="Professional reference letters for Luca Kosowski." canonicalPath="/references.html" ogTitle="References – Luca Kosowski" ogDescription="Professional reference letters for Luca Kosowski.">
<header class="site-header">
    <div class="header-content">
      <a href="index.html" class="logo">Luca Kosowski</a>
      <button class="menu-toggle" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="main-nav">
        <a href="index.html#experience">Experience</a>
        <a href="index.html#education">Education</a>
        <a href="articles.html">Articles</a>
        <a href="projects.html">Projects</a>
        <a href="references.html">References</a>
        <a href="index.html#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="main-wrapper">

      <section id="references" class="content-section">
        <p class="section-label">References</p>
        <h1>Professional References</h1>
        <p class="lead">Letters of recommendation of the Italian Ambassador of Italy to Malaysia attesting to my professional experience and character.</p>

        <div class="preview-grid">

          <!-- English Letter -->
          <div class="project-card">
            <h3 style="margin-bottom: 0.5rem;">Reference Letter (English)</h3>
            <p class="project-meta" style="margin-bottom: 1rem;">PDF Document</p>
            <p>A formal letter of recommendation detailing my professional contributions, work ethic, and achievements.</p>
            <div style="margin-top: 1.5rem;">
                <a href="Reference_Letter_English.pdf" target="_blank" class="cta-secondary">View / Download PDF</a>
            </div>
          </div>

          <!-- Italian Letter -->
          <div class="project-card">
            <h3 style="margin-bottom: 0.5rem;">Lettera di Referenze (Italiano)</h3>
            <p class="project-meta" style="margin-bottom: 1rem;">Documento PDF</p>
            <p>Lettera di referenze formale che attesta il mio percorso professionale, le competenze acquisite e i risultati ottenuti.</p>
            <div style="margin-top: 1.5rem;">
                <a href="Reference_Letter_Italian.pdf" target="_blank" class="cta-secondary">Visualizza / Scarica PDF</a>
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>

  <footer class="site-footer">
    <p>Luca Kosowski</p>
  </footer>

  <!-- Scripts -->
  <script is:inline>
    // Mobile Menu Toggle
    const menuToggle = document.querySelector('.menu-toggle');
    const siteHeader = document.querySelector('.site-header');
    const navLinks = document.querySelectorAll('.main-nav a');

    if (menuToggle) {
        menuToggle.addEventListener('click', () => {
            siteHeader.classList.toggle('nav-open');
        });

        // Close menu when a link is clicked
        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                siteHeader.classList.remove('nav-open');
            });
        });
    }
  </script>
</BaseLayout>

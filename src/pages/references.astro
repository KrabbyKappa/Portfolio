---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import englishReferencePreview from '../assets/reference-letter-english-preview.jpg';
import italianReferencePreview from '../assets/reference-letter-italian-preview.jpg';
---
<BaseLayout title="References – Luca Kosowski" description="Professional reference letters for Luca Kosowski in English and Italian, with direct PDF access and contact context for recruiters and collaborators." canonicalPath="/references.html" ogTitle="References – Luca Kosowski" ogDescription="Professional reference letters for Luca Kosowski in English and Italian, with direct PDF access and contact context for recruiters and collaborators.">
<header class="site-header">
    <div class="header-content">
      <a href="index.html" class="logo">Luca Kosowski</a>
      <nav class="main-nav">
        <a href="index.html" class="nav-mobile-only">Home</a>
        <a href="https://websites.lucakosowski.com/">Websites</a>
        <a href="articles.html" class="nav-desktop-only">Articles</a>
        <a href="projects.html">Projects</a>
        <a href="references.html">References</a>
        <a href="contact.html">Contact</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="main-wrapper">

      <section class="page-hero references-page-hero">
        <h1>Professional References</h1>
        <p class="lead">Letters of recommendation from the Ambassador of Italy to Malaysia, attesting to my professional experience and character.</p>
      </section>

      <section id="references" class="reference-preview-grid" aria-label="Reference letters">
        <article class="reference-document" data-reference-document="english" data-expanded="false">
          <button class="reference-document-button" type="button" data-reference-toggle aria-expanded="false" aria-label="Enlarge the English reference letter">
            <Image src={englishReferencePreview} width={1224} height={1684} format="webp" alt="Preview of the English reference letter" loading="eager" decoding="async" />
            <span class="reference-document-title">Reference Letter</span>
          </button>
          <a href="Reference_Letter_English.pdf" target="_blank" rel="noopener noreferrer" class="reference-pdf-link">Open PDF</a>
        </article>

        <article class="reference-document" data-reference-document="italian" data-expanded="false">
          <button class="reference-document-button" type="button" data-reference-toggle aria-expanded="false" aria-label="Ingrandisci la lettera di referenze">
            <Image src={italianReferencePreview} width={1224} height={1684} format="webp" alt="Anteprima della lettera di referenze in italiano" loading="eager" decoding="async" />
            <span class="reference-document-title">Lettera di Referenze</span>
          </button>
          <a href="Reference_Letter_Italian.pdf" target="_blank" rel="noopener noreferrer" class="reference-pdf-link">Apri PDF</a>
        </article>
      </section>

    </div>
  </main>

  <footer class="site-footer">
    <nav class="footer-links" aria-label="Contact and website links">
      <a href="mailto:hello@lucakosowski.com">Email</a>
      <a href="https://www.linkedin.com/in/luca-kosowski/">LinkedIn</a>
      <a href="https://websites.lucakosowski.com/">Website Development</a>
    </nav>
  </footer>

  <!-- Scripts -->
  <script is:inline>
    const referenceGrid = document.querySelector('.reference-preview-grid');
    const referenceDocuments = referenceGrid
      ? Array.from(referenceGrid.querySelectorAll('[data-reference-document]'))
      : [];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    referenceDocuments.forEach((documentCard) => {
      const toggle = documentCard.querySelector('[data-reference-toggle]');
      toggle?.addEventListener('click', async () => {
        const wasExpanded = documentCard.dataset.expanded === 'true';
        const firstRects = new Map(referenceDocuments.map((item) => [item, item.getBoundingClientRect()]));

        referenceDocuments.forEach((item) => {
          const isExpanded = item === documentCard && !wasExpanded;
          item.dataset.expanded = String(isExpanded);
          item.querySelector('[data-reference-toggle]')?.setAttribute('aria-expanded', String(isExpanded));
        });
        referenceGrid.dataset.expandedReference = wasExpanded ? '' : documentCard.dataset.referenceDocument;

        await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
        if (reducedMotion.matches) return;

        referenceDocuments.forEach((item) => {
          const first = firstRects.get(item);
          const last = item.getBoundingClientRect();
          const deltaX = first.left - last.left;
          const deltaY = first.top - last.top;
          const scaleX = first.width / last.width;
          const scaleY = first.height / last.height;

          item.animate(
            [
              { transform: `translate(${deltaX}px, ${deltaY}px) scale(${scaleX}, ${scaleY})` },
              { transform: 'translate(0, 0) scale(1, 1)' },
            ],
            { duration: 680, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          );
        });
      });
    });

  </script>
</BaseLayout>

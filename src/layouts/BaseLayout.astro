---
import { seoSite } from '../data/seo/site';
import SeoJsonLd from '../components/SeoJsonLd.astro';
import { assetUrl, canonicalUrl, routeOrFallback } from '../lib/seo/url';
import { schemaForRoute } from '../lib/seo/schema';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalPath = '/',
  ogTitle = title,
  ogDescription = description,
  ogImage = seoSite.defaultImage,
} = Astro.props;

const route = routeOrFallback(canonicalPath, { title, description });
const pageTitle = title || route.title;
const pageDescription = description || route.description;
const canonical = canonicalUrl(route.path);
const ogImageUrl = assetUrl(ogImage);
const schema = schemaForRoute({ path: route.path, title: pageTitle, description: pageDescription, family: route.family });
const isHomeRoute = route.path === '/';
---
<!DOCTYPE html>
<html lang={route.language}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription}>
  <link rel="canonical" href={canonical}>

  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content={seoSite.name}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={ogDescription}>
  <meta name="twitter:image" content={ogImageUrl}>

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  {isHomeRoute && (
    <link
      rel="preload"
      as="image"
      href="/profile-660.jpg"
      imagesrcset="/profile-440.jpg 440w, /profile-660.jpg 660w, /profile.jpg 937w"
      imagesizes="(max-width: 680px) 160px, 220px"
      fetchpriority="high"
    />
  )}
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/rebrand.css">
  <SeoJsonLd data={schema} />
  <script data-goatcounter="https://lucakosowski.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
</head>
<body class:list={[{ 'route-contact': route.path === '/contact.html' }]}>
  <slot />
  <script is:inline>
    (() => {
      const clickableCards = Array.from(document.querySelectorAll('[data-showcase-card-href]'));
      clickableCards.forEach((card) => {
        let startX = 0;
        let startY = 0;
        let dragged = false;
        card.addEventListener('pointerdown', (event) => {
          startX = event.clientX;
          startY = event.clientY;
          dragged = false;
        }, { passive: true });
        card.addEventListener('pointermove', (event) => {
          if (Math.hypot(event.clientX - startX, event.clientY - startY) > 8) dragged = true;
        }, { passive: true });
        card.addEventListener('click', (event) => {
          if (event.target.closest('a') || dragged) return;
          window.location.href = card.dataset.showcaseCardHref;
        });
        card.addEventListener('keydown', (event) => {
          if (event.target.closest('a')) return;
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            window.location.href = card.dataset.showcaseCardHref;
          }
        });
      });

      const wheels = Array.from(document.querySelectorAll('[data-trsnparent-mini-wheel]'));
      if (!wheels.length) return;
      const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
      wheels.forEach((wheel) => {
        const wrap = wheel.querySelector('.mini-cylinder-wrap');
        const items = Array.from(wheel.querySelectorAll('.mini-cylinder-item'));
        if (!wrap || !items.length) return;
        const theta = 360 / items.length;
        let currentAngle = 0;
        let frame = 0;
        let isVisible = true;
        let lastPaintTime = performance.now();
        const AUTOSPIN_DEGREES_PER_MS = 360 / (6 * 60 * 1000);

        const updateDepth = () => {
          const width = wrap.offsetWidth || Number.parseFloat(getComputedStyle(wrap).width) || 150;
          const naturalRadius = (width / 2) / Math.tan(Math.PI / items.length);
          const radius = Math.ceil(naturalRadius + 14);
          wheel.style.setProperty('--mini-cylinder-depth', `${radius}px`);
          items.forEach((item, index) => {
            item.style.setProperty('--mini-cylinder-angle', `${index * theta}deg`);
          });
        };

        const normalize = (angle) => ((((angle % 360) + 540) % 360) - 180);
        const paint = (now = performance.now()) => {
          const delta = Math.min(80, Math.max(0, now - lastPaintTime));
          lastPaintTime = now;
          if (!reduceMotion && isVisible) currentAngle -= delta * AUTOSPIN_DEGREES_PER_MS;
          wrap.style.setProperty('--mini-rotate', `${currentAngle}deg`);
          items.forEach((item, index) => {
            const distance = Math.abs(normalize(index * theta + currentAngle));
            const frontness = Math.max(0, Math.cos(distance * Math.PI / 180));
            item.style.opacity = String(0.18 + frontness * 0.82);
            item.style.zIndex = String(Math.round(frontness * 20));
          });
          if (!reduceMotion && isVisible) frame = requestAnimationFrame(paint);
          else frame = 0;
        };
        const requestPaint = () => {
          if (!frame) frame = requestAnimationFrame(paint);
        };
        updateDepth();
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              isVisible = entry.isIntersecting;
              wheel.classList.toggle('is-mini-visible', isVisible);
              if (isVisible) {
                lastPaintTime = performance.now();
                requestPaint();
              }
            });
          }, { threshold: 0.18 });
          observer.observe(wheel);
        } else {
          wheel.classList.add('is-mini-visible');
        }
        window.addEventListener('resize', () => { updateDepth(); requestPaint(); }, { passive: true });
        paint();
      });
    })();
  </script>
</body>
</html>
